# =====================================================================
# LingXiao - systemd unit (production)
# ---------------------------------------------------------------------
# Install:
#   sudo cp lingxiao.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lingxiao
#   sudo systemctl status lingxiao
#
# Adjust User / paths / JVM memory for your server.
# =====================================================================
[Unit]
Description=LingXiao Admin (Spring Boot)
Documentation=https://example.com/lingxiao
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=lingxiao
Group=lingxiao
WorkingDirectory=/opt/lingxiao
Environment="JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"
ExecStart=/usr/bin/java -Xms256m -Xmx512m -XX:+UseG1GC -jar /opt/lingxiao/lingxiao.jar --spring.profiles.active=prod
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
LimitNOFILE=65535
StandardOutput=append:/opt/lingxiao/logs/systemd.out.log
StandardError=append:/opt/lingxiao/logs/systemd.err.log

[Install]
WantedBy=multi-user.target
