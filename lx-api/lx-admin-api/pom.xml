<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      lx-admin-api：后台接口契约
      =====================================================================
      放登录、当前用户、菜单等跨层共享的请求 / 响应模型。
      只依赖 lx-common-core 与 validation-api，不依赖 Spring Web，
      这样后续生成 OpenAPI 或拆 RPC 时不会被 Web 容器绑死。
    -->
    <parent>
        <groupId>com.lingxiao</groupId>
        <artifactId>lx-api</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lx-admin-api</artifactId>
    <name>lx-admin-api</name>
    <description>后台接口请求 / 响应模型</description>

    <dependencies>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
