<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      lx-boot：启动与装配模块
      =====================================================================
      这是唯一可执行的 Spring Boot 应用，职责只有：
        - 启动类、Profile、端口；
        - 依赖装配：common / framework / modules / api；
        - Flyway 迁移位置；
        - 打包（spring-boot-maven-plugin）。

      禁止在这里写业务代码；业务都在 lx-modules-* 里。
    -->
    <parent>
        <groupId>com.lingxiao</groupId>
        <artifactId>lingxiao</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lx-boot</artifactId>
    <name>lx-boot</name>
    <description>凌霄启动模块</description>

    <dependencies>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-module-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-module-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-module-job</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-module-generator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-module-cms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-module-member</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-module-i18n</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-module-demo</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>7.15.0</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          接口文档：Knife4j 4.4.0 + SpringDoc 1.7.0。
          只放在启动模块，common / modules 不感知文档框架；升级 / 移除只改这里。
        -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>lingxiao</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.lingxiao.boot.LingxiaoApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
