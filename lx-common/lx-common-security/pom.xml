<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      lx-common-security：认证与安全域
      =====================================================================
      凌霄有三套安全域，互不认 Token：
        platform  平台后台（v1.0 唯一实装）
        tenant    租户应用（独立立项后再建）
        member    前台会员（v1.2 模块）

      本模块只提供“平台域”的实现，另外两套只保留命名与文档，
      避免 v1.0 就引入用不到的租户 / 会员复杂度。
    -->
    <parent>
        <groupId>com.lingxiao</groupId>
        <artifactId>lx-common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lx-common-security</artifactId>
    <name>lx-common-security</name>
    <description>Sa-Token 平台安全域、登录上下文、鉴权异常处理</description>

    <dependencies>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 权限注解切面需要 AOP；只引 starter，不引完整 Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
