<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      lx-module-cms：内容管理模块（v1.1，可选模块，启动期插拔）
      =====================================================================
      边界
        - 只操作 cms_* 表；不碰 sys_user / sys_menu / sys_file 的业务数据，
          菜单与权限只通过自己的迁移脚本幂等导入。
        - 文件只存 fileId / URL，不建自己的文件表。
        - 作者 / 审核人只存 user_id，展示时由基座用户信息兜底。
        - 不引 lx-module-system 依赖：富文本清洗走 lx-common-web，避免业务反向耦合。

      开关
        lx.module.modules.cms.enabled=true    Bean 装配、迁移执行、菜单下发
        lx.module.modules.cms.enabled=false   接口 404、迁移不扫描、菜单不下发
        改开关必须重启（启动期插拔，不做运行期热切换）。
    -->
    <parent>
        <groupId>com.lingxiao</groupId>
        <artifactId>lx-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lx-module-cms</artifactId>
    <name>lx-module-cms</name>
    <description>内容管理：站点 / 栏目 / 文章 / 标签（v1.1 后台链路）</description>

    <dependencies>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-log</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
