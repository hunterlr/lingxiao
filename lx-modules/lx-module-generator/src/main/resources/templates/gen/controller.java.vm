package ${packageName}.controller;

import com.lingxiao.common.core.domain.PageResult;
import com.lingxiao.common.core.domain.R;
import com.lingxiao.common.log.annotation.Log;
import com.lingxiao.common.log.enums.BusinessType;
import com.lingxiao.common.security.annotation.RequiresPermission;
import ${packageName}.entity.${className};
import ${packageName}.service.${className}Service;
import lombok.RequiredArgsConstructor;
#if($hasDateQuery)
import org.springframework.format.annotation.DateTimeFormat;
#end
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import javax.validation.Valid;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.LocalTime;

/**
 * ${functionName}接口。
 *
 * <p>路径挂在 {@code /api/admin${apiPath}}，权限码前缀
 * {@code ${permissionPrefix}}；生成的按钮权限 SQL 见同目录 menu.sql。</p>
 *
 * <p>模块开关没有自动加 {@code @ConditionalOnProperty}：
 * 新模块通常还没有在 application.yml 里登记开关，硬加会让 Controller 永远不装配。
 * 需要可裁剪时，由接入方自行补一个配置项和注解。</p>
 *
 * @author ${author}
 * @since ${datetime}
 */
@RestController
@RequestMapping("/api/admin${apiPath}")
@RequiredArgsConstructor
public class ${className}Controller {

    private final ${className}Service ${businessName}Service;

    @RequiresPermission("${permissionPrefix}:list")
    @GetMapping("/list")
    public R<PageResult<${className}>> list(
            @RequestParam(defaultValue = "1") long pageNum,
            @RequestParam(defaultValue = "10") long pageSize#foreach($col in $queryColumns),
            ${col.paramAnnotation}@RequestParam(required = false) ${col.javaType} ${col.javaField}#end) {
        return R.ok(${businessName}Service.page(pageNum, pageSize#foreach($col in $queryColumns), ${col.javaField}#end));
    }

    @RequiresPermission("${permissionPrefix}:list")
    @GetMapping("/{${pkField}}")
    public R<${className}> detail(@PathVariable ${pkType} ${pkField}) {
        return R.ok(${businessName}Service.detail(${pkField}));
    }

    @RequiresPermission("${permissionPrefix}:add")
    @Log(title = "${functionNameJava}", businessType = BusinessType.INSERT)
    @PostMapping
    public R<${pkType}> add(@Valid @RequestBody ${className} entity) {
        return R.ok(${businessName}Service.create(entity));
    }

    @RequiresPermission("${permissionPrefix}:edit")
    @Log(title = "${functionNameJava}", businessType = BusinessType.UPDATE)
    @PutMapping("/{${pkField}}")
    public R<Void> update(@PathVariable ${pkType} ${pkField}, @Valid @RequestBody ${className} entity) {
        ${businessName}Service.update(${pkField}, entity);
        return R.ok();
    }

    @RequiresPermission("${permissionPrefix}:remove")
    @Log(title = "${functionNameJava}", businessType = BusinessType.DELETE)
    @DeleteMapping("/{${pkField}}")
    public R<Void> remove(@PathVariable ${pkType} ${pkField}) {
        ${businessName}Service.delete(${pkField});
        return R.ok();
    }
}
