<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      lx-module-i18n：数据库语言包（v1.4，可选模块，启动期插拔）
      =====================================================================
      边界
        - 只操作 i18n_* 表；不碰 CMS / 会员业务表，不建跨模块外键。
        - 通过 @Primary MessageSource 把 DB 译文接到全站；资源包仍保留兜底。
        - 后台接口 /api/admin/i18n/**；门户公开接口 /api/portal/i18n/**。
        - 关闭时：Bean 不装配、迁移不扫描、菜单不下发、接口 404。

      开关
        lx.module.i18n.enabled=true    装配 Bean、执行 V39+ 迁移、下发菜单
        lx.module.i18n.enabled=false   接口 404、迁移不扫描、菜单不下发
        改开关必须重启（启动期插拔，不做运行期热切换）。
    -->
    <parent>
        <groupId>com.lingxiao</groupId>
        <artifactId>lx-modules</artifactId>
        <version>1.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>lx-module-i18n</artifactId>
    <name>lx-module-i18n</name>
    <description>数据库语言包：翻译键 / 译文 / 发布回滚 / 门户语言包</description>

    <dependencies>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-log</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
