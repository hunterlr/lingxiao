<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      lx-module-workflow：工作流（v1.5 第一刀，可选模块，启动期插拔）
      =====================================================================
      边界
        - 引擎用 Flowable 6.8.0（process 引擎），业务只依赖 WorkflowEngine 接口，
          不在业务代码里注入 RuntimeService / TaskService。
        - 引擎自建 ACT_*；本模块只建 wf_category / wf_process_def。
        - 后台接口 /api/admin/workflow/**；不碰 CMS / 会员业务表。
        - 关闭时：Bean 不装配、ACT_* 不建、接口 404、菜单不下发。

      开关
        lx.module.modules.workflow.enabled=true    装配引擎与 Bean、执行 V46+ 迁移、下发菜单
        lx.module.modules.workflow.enabled=false   接口 404、迁移不扫描、菜单不下发
        改开关必须重启（启动期插拔，不做运行期热切换）。

      第一刀范围
        流程定义（BPMN 上传 + 内置两级示例）/ 发起 / 待办 / 已办 / 我发起的 /
        同意 / 驳回（即终止）/ 撤回。表单、会签、条件分支、CMS 审核接入留到后面的刀。
    -->
    <parent>
        <groupId>com.lingxiao</groupId>
        <artifactId>lx-modules</artifactId>
        <version>1.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>lx-module-workflow</artifactId>
    <name>lx-module-workflow</name>
    <description>工作流：流程定义 / 发起 / 待办 / 同意驳回 / 撤回（Flowable 6.8）</description>

    <dependencies>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lingxiao</groupId>
            <artifactId>lx-common-log</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 工作流引擎：只引 process 引擎，不引 REST / 表单引擎 -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>