# =====================================================================
# 凌霄 CMS 门户 · 本地环境变量示例
# =====================================================================
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略。

# Spring Boot 服务根地址（Nitro 代理由此转发同源 /api/**）
NUXT_BACKEND_BASE=http://127.0.0.1:8080

# 默认站点标识，必须与后台「CMS → 站点」里的 siteKey 一致
NUXT_PUBLIC_SITE_KEY=main

# 门户对外访问地址，用于 canonical / og:url
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# 列表每页条数（接口上限 50）
NUXT_PUBLIC_PAGE_SIZE=9
